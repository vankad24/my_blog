# Django
# openssl rand -hex 32
SECRET_KEY=django-insecure-change-me-in-production
DEBUG=True

# Database (PostgreSQL)
DB_ENGINE=django.db.backends.postgresql
DB_NAME=my_blog
DB_USER=postgres
DB_PASSWORD=1234
DB_HOST=postgres
DB_PORT=5432

#--- PgAdmin ---
PGADMIN_EMAIL=user@mail.ru
PGADMIN_PASSWORD=1234

# JWT
JWT_ACCESS_TOKEN_LIFETIME=60
JWT_REFRESH_TOKEN_LIFETIME=10080

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Backup
BACKUP_KEY=test_backup_key

# Site Domain
SERVER_NAME="example.com"

# Redis
# В Docker: redis://redis:6379/0
# Локально: redis://localhost:6379/0
REDIS_URL=redis://redis:6379/0

# Просмотры постов и гостевые токены
POST_VIEW_TTL=1800
GUEST_TOKEN_TTL=2592000

# Ограничение попыток входа/регистрации: 5 попыток за 60 секунд
AUTH_RATE_LIMIT=5
AUTH_RATE_WINDOW=60

